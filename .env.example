# Meeting Notetaker - Environment Variables
# Copy this file to .env and fill in values

# App
SECRET_KEY=change-me-to-a-random-secret-key
DATABASE_URL=sqlite:///./meeting_notetaker.db

# Lite LLM (OpenAI-compatible API)
LLM_ENDPOINT=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=not-needed

# Whisper (local model size: tiny, base, small, medium, large)
WHISPER_MODEL=base

# Audio storage
AUDIO_DIR=./audio_recordings

# Google Meet Bot
BOT_HEADLESS=false
BOT_TIMEOUT_MINUTES=120

# Upload limits
MAX_AUDIO_SIZE_MB=500
